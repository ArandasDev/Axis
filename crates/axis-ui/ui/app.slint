import { Tokens } from "tokens.slint";
export { Tokens }

component PrimaryButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    border-radius: Tokens.radius-btn;
    background: touch.pressed ? Tokens.accent.darker(0.15) : touch.has-hover ? Tokens.accent.brighter(0.08) : Tokens.accent;
    min-width: label.preferred-width + 2 * Tokens.space-l;
    height: label.preferred-height + Tokens.space-m;
    animate background { duration: Tokens.dur-fast; }

    label := Text {
        text: root.text;
        color: Tokens.bg;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Tela sobre o conteúdo enquanto não há conexão com o núcleo.
component ConnectionScreen inherits Rectangle {
    in property <int> connection;
    in property <string> message;
    callback start-daemon();

    background: Tokens.bg;
    // Engole os cliques para o conteúdo por baixo.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        spacing: Tokens.space-m;

        Text {
            text: "Axis";
            color: Tokens.text;
            font-family: Tokens.font-heading;
            font-weight: 600;
            font-size: 32px;
            horizontal-alignment: center;
        }

        Text {
            text: root.message;
            color: Tokens.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.connection == 2: HorizontalLayout {
            alignment: center;
            PrimaryButton {
                text: "Iniciar";
                clicked => { root.start-daemon(); }
            }
        }
    }
}

export component App inherits Window {
    /// 0 conectando, 1 conectado, 2 núcleo parado, 3 incompatível.
    in property <int> connection: 0;
    in property <string> connection-message: "Conectando ao núcleo…";
    callback start-daemon();

    title: "Axis";
    background: Tokens.bg;
    default-font-family: Tokens.font-body;
    preferred-width: 1100px;
    preferred-height: 720px;

    if root.connection != 1: ConnectionScreen {
        width: 100%;
        height: 100%;
        connection: root.connection;
        message: root.connection-message;
        start-daemon => { root.start-daemon(); }
    }
}
